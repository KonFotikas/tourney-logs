{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tourney-logs",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // Serve the site at https://tourney-logs.<your-subdomain>.workers.dev
  "workers_dev": true,

  // The site (public/) is served as static files; /api/* and /img/* go to the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Tournaments, matches, decks and decklist images. Created automatically on the first deploy.
  // If a deploy says the database can't be found, create a D1 database named "tourney-logs" in the
  // Cloudflare dashboard and add its id here as "database_id".
  "d1_databases": [{ "binding": "DB", "database_name": "tourney-logs" }],

  // Every 2 hours, check each ongoing tournament on Challonge (12 requests a day per ongoing tournament,
  // none when nothing is ongoing). Finished tournaments are skipped.
  "triggers": { "crons": ["0 */2 * * *"] },

  // Not secret. Secrets (CHALLONGE_USERNAME, CHALLONGE_API_KEY, ADMIN_PASSWORD, optional ADMIN_TOKEN)
  // are set in the Cloudflare dashboard: Worker > Settings > Variables and Secrets.
  // Keep variables added in the Cloudflare dashboard when deploying (otherwise a deploy removes plain-text
  // ones that aren't listed here). Secrets are always kept.
  "keep_vars": true,

  // MONTHLY_LIMIT: Challonge API requests allowed per month; nothing calls Challonge past it until the 1st.
  // STALE_DAYS: stop checking a tournament automatically after this many days with no changes.
  "vars": { "MONTHLY_LIMIT": "500", "STALE_DAYS": "60" },

  "observability": { "enabled": true }
}
